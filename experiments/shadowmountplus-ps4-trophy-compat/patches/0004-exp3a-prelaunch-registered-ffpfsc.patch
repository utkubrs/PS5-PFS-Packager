+/*
+ * EXP3A: also run on the ShellCore pre-launch path for ALREADY REGISTERED
+ * FFPFSC games. The install/remount-only EXP3 hook is bypassed otherwise.
+ * The underlying EXP3 mirror remains opt-in and add-only.
+ */
+void sm_install_exp3_launch_probe(const char *title_id,
+                                  const char *source_path) {
+  if (!exp3_ps4_title_id(title_id) || !source_path ||
+      !is_under_image_mount_base(source_path))
+    return;
+  char src_sce_sys[MAX_PATH], appmeta[MAX_PATH];
+  int a = snprintf(src_sce_sys, sizeof(src_sce_sys),
+                   "%s/sce_sys", source_path);
+  int b = snprintf(appmeta, sizeof(appmeta),
+                   "%s/%s", APPMETA_BASE, title_id);
+  if (a <= 0 || (size_t)a >= sizeof(src_sce_sys) ||
+      b <= 0 || (size_t)b >= sizeof(appmeta)) {
+    log_debug("  [PS4-TROPHY-EXP3A] invalid source/title path: %s",
+              title_id);
+    return;
+  }
+  log_debug("  [PS4-TROPHY-EXP3A] launch-prep title=%s source=%s",
+            title_id, source_path);
+  exp3_ps4_mirror_on_mount(title_id, src_sce_sys, appmeta);
+}
